# ==============================================================================
# Jellyfin-refina - Variáveis de Ambiente
# ==============================================================================

# Porta de execução do serviço (Padrão: 8585)
# NOTA: Não utilize as portas 80, 81, 443, 3000, 5055, 6767, 7878, 8096, 8191, 8989, 9000, 9091, 9696, 51413
PORT=8585

# Chave secreta para assinatura dos cookies de sessão (gere uma chave aleatória)
SECRET_KEY=sua_chave_secreta_super_segura_aqui_gerada_aleatoriamente

# Diretório para armazenamento persistente do SQLite
DATA_DIR=/app/data

# Chaves de API Opcionais (Também podem ser configuradas pela interface em /settings)
# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# The Movie Database (TMDB) API Key v3 (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
